# Copy this file OUTSIDE the repository, for example to:
#   /home/ma-user/.config/agentflow/search-gateway.env
# Then replace the placeholder token and run: chmod 600 <that-file>

SEARCH_GATEWAY_BASE_URL="http://7.150.10.123/agentflow-search"
SEARCH_GATEWAY_TOKEN="REPLACE_WITH_THE_64_CHARACTER_GATEWAY_TOKEN"

# These timeouts apply only to training-server -> EC2 Gateway requests.
SEARCH_GATEWAY_CONNECT_TIMEOUT="5"
SEARCH_GATEWAY_READ_TIMEOUT="60"
SEARCH_GATEWAY_MAX_RETRIES="0"
SEARCH_GATEWAY_RETRY_BACKOFF="0.5"

# Startup readiness performs real low-cost egress calls through Windows.
SEARCH_GATEWAY_SMOKE_URL="https://www.baidu.com/"
SEARCH_GATEWAY_SMOKE_WIKIPEDIA_QUERY="Moon"
# Keep false while Brave/Yibu is disabled. Set true before re-enabling the Tool.
SEARCH_GATEWAY_CHECK_BRAVE="false"
SEARCH_GATEWAY_SMOKE_BRAVE_QUERY="Moon"

# Enable this only after EC2 Nginx is switched to HTTPS.  The file must be the
# CA/certificate used to verify the EC2 endpoint; never set TLS verify=False.
# SEARCH_GATEWAY_CA_BUNDLE="/home/ma-user/.config/agentflow/ec2-search-ca.pem"

# Optional when the launch shell is not already using the AgentFlow environment.
# AGENTFLOW_PYTHON_BIN="/root/miniconda3/envs/agent_flow/bin/python"
